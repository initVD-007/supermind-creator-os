# --- Backend ---
# The Secret Vault - Never push API keys!
backend/.env
.env

# Virtual Environment - Too heavy to push
backend/venv/
venv/

# Python Cache - Temporary files created by the interpreter
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- Frontend ---
# Dependencies - These are re-installed via 'npm install'
frontend/node_modules/
node_modules/

# Next.js Build Output
frontend/.next/
.next/
out/

# Environment Variables
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# --- General ---
# Operating System files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*